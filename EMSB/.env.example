# Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to Git

# Application
NODE_ENV=development
PORT=4000

# MongoDB Atlas / Local
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=eniac_ems

# JWT
JWT_SECRET=change-this-secret-at-least-32-chars-in-production
JWT_EXPIRES_IN=24h

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:5173

# Frontend base URL - used to build invitation links sent by email
FRONTEND_BASE_URL=http://localhost:5173

# Account invitations
INVITE_EXPIRY_DAYS=7
# MAIL_PROVIDER=log  -> prints invite links to the server console (development)
# MAIL_PROVIDER=smtp -> sends real email via SMTP (production)
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Eniac Inc. EMS <no-reply@eniacinc.com>

# Logging
LOG_LEVEL=info
# Rate limits (requests per 15 minutes). The auth limiter counts login attempts
# per IP + email. Tests override these to very high values.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50

# Seed script passwords (npm run seed) — DEV ONLY.
# In development each falls back to a built-in default. In production these are
# REQUIRED and the dev defaults are refused, so set a strong value per role.
# SEED_ADMIN_PASSWORD=
# SEED_HR_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_SUPERVISOR_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
