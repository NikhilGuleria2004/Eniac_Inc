{
  "name": "eniac-emsb",
  "version": "1.0.0",
  "description": "Eniac Inc. Employee Management System Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/integrations/pdf/fonts && cp src/integrations/pdf/fonts/*.ttf dist/integrations/pdf/fonts/",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "wipe": "tsx src/scripts/wipe.ts",
    "seed:dev": "tsx src/scripts/seed-dev.ts",
    "seed:cms": "tsx src/scripts/seed-cms.ts",
    "seed:cms:test": "tsx src/scripts/seed-cms-test.ts",
    "seed:prod": "tsx src/scripts/seed-production.ts",
    "seed:test": "tsx src/scripts/wipe.ts && tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.7.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.15.2",
    "pino": "^9.2.1",
    "pino-http": "^10.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vitest/coverage-v8": "^1.5.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.3.2",
    "supertest": "^6.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
